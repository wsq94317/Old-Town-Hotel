; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Old Town Hotel (Godot port)"
config/description="Phase 1 wiring check: runs ParityScenario and writes the ledger for diffing."
run/main_scene="res://Main.tscn"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")

[display]

; 竖屏抖音/TikTok 小游戏，参考分辨率 1080x1920（与 Unity CanvasScaler 的基准一致，
; 所有设计 token 的像素值都是这个空间下的值）。
; stretch mode=canvas_items + aspect=expand 对应 Unity 的
; "Scale With Screen Size" + "Match Width Or Height"：等比缩放，长边多出来的部分露出更多内容
; 而不是拉伸变形。
window/size/viewport_width=1080
window/size/viewport_height=1920
window/size/window_width_override=540
window/size/window_height_override=960
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[dotnet]

project/assembly_name="OldTownHotel.Godot"

[editor_plugins]

; Godot AI (MIT, addons/godot_ai) —— 给 Godot 编辑器装一个 MCP server，
; 相当于 Unity MCP 的对位物：让 AI 能直接读节点树、改属性、在编辑器里查证状态，
; 而不是只能「写代码 → 编译 → 跑 → 截图 → 看」。
;
; 只影响编辑器，不进游戏运行时——parity-check 和 --shot 截图都不经过它。
; 注意 MCP server 是在会话启动时加载的：装好之后要**重启一次 Claude Code 会话**才生效。
enabled=PackedStringArray("res://addons/godot_ai/plugin.cfg")
